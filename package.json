{
  "name": "cmaform",
  "version": "0.1.0",
  "description": "Terraform-style declarative management for Anthropic Managed Agents, Skills, Memory Stores, Environments, and Vaults.",
  "keywords": [
    "anthropic",
    "claude",
    "claude-code",
    "managed-agents",
    "agents",
    "skills",
    "memory-stores",
    "environments",
    "vaults",
    "mcp",
    "anthropic-sdk",
    "terraform",
    "cli",
    "iac"
  ],
  "license": "MIT",
  "author": "joe-re",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-re/cmaform.git"
  },
  "bugs": {
    "url": "https://github.com/joe-re/cmaform/issues"
  },
  "homepage": "https://github.com/joe-re/cmaform#readme",
  "type": "module",
  "bin": {
    "cmaform": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7"
  }
}
